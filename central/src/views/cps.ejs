<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Central Controller</title>
  <style>
    *, ::before, ::after {
      box-sizing: border-box;
    }
    body { 
      font-family: sans-serif;
      margin: 2rem;
    }
    .Cps-container {
      display: grid;
      grid-template-columns: repeat(5, 1fr); /* 5 columnas iguales */
      gap: 10px; /* separación entre items */
      padding: 10px;
    }
    .Cps {
      background: darkgray;
      border: 1px solid #ddd;
      padding: 10px;
      margin-bottom: 10px;
      border-radius: 6px;
    }
  </style>
  <script src="/socket.io/socket.io.js"></script>

</head>
<body>
  <h1>CPS</h1>
    
  <% if (readedCPs.error) { %>
    <p>Base de datos vacia</p>
  <% } else { %>
    <div class="Cps-container">
      <% readedCPs.forEach(cp => { %>
        <div class="Cps">
          <h2><%= cp.Ubicacion %></h2>
          <p>Id CP: <%= cp.ID_UUID %></p>
          <p>Ubicacion: <%= cp.UbicacionLarga %> </p>
          <p>Precio: <%= cp.Precio_KWH %> KW/h</p>
          <div>
            <button>Boton 1</button>
            <button>Boton 2</button>
            <button>Boton 3</button>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
  <script>
    const socker = io();
    socker.on("NuevaConexion", (data) => {
      
    })
  </script>
</body>
</html>